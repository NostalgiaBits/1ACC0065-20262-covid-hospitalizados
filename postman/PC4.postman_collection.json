{
  "info": {
    "name": "CC65 TF · PC4 · API COVID hospitalizados",
    "description": "Pruebas de la API coordinadora (Go): predicción < 100 ms con caché Redis, usuarios con JWT, entrenamiento distribuido en el clúster TCP y consultas a MongoDB. Ejecutar en orden (Run collection); para la prueba de latencia, ejecutar la carpeta 3 con 50 iteraciones.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Estado del sistema",
      "item": [
        {
          "name": "Salud",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Responde en menos de 100 ms\", () => pm.expect(pm.response.responseTime).to.be.below(100));",
                  "const r = pm.response.json();",
                  "pm.test(\"API en línea\", () => pm.expect(r.estado).to.eql(\"ok\"));",
                  "pm.test(\"MongoDB y Redis conectados\", () => { pm.expect(r.mongo).to.be.true; pm.expect(r.redis).to.be.true; });",
                  "pm.test(\"3 nodos activos\", () => pm.expect(r.nodos_activos).to.eql(3));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/salud",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "salud"
              ]
            },
            "description": "Estado de la API, MongoDB, Redis y de los nodos del clúster."
          }
        },
        {
          "name": "Modelo vigente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Responde en menos de 100 ms\", () => pm.expect(pm.response.responseTime).to.be.below(100));",
                  "const r = pm.response.json();",
                  "pm.collectionVariables.set(\"versionInicial\", r.version);",
                  "pm.test(\"38 pesos y categorías válidas\", () => { pm.expect(r.pesos).to.have.lengthOf(38); pm.expect(r.categorias.departamento).to.include(\"LIMA\"); });",
                  "pm.test(\"AUC sobre la prueba real > 0.8\", () => pm.expect(r[\"metricas_umbral_0.5\"].auc).to.be.above(0.8));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/modelo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "modelo"
              ]
            },
            "description": "Pesos, odds ratios, métricas y categorías aceptadas por /predecir."
          }
        },
        {
          "name": "Clúster",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 200\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"Topología en estrella\", () => pm.expect(r.topologia).to.include(\"estrella\"));",
                  "pm.test(\"Cada nodo tiene el dataset de 1 050 000 filas\", () => r.nodos.forEach(n => pm.expect(n.filas).to.eql(1050000)));"
                ]
              }
            }
          ],
          "request": {
